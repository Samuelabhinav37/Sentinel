#ps1_sysnative
$ErrorActionPreference = "Stop"
$log = "C:\Windows\Temp\sentinel-userdata.log"
function Log($msg) { "$(Get-Date -Format o) $msg" | Out-File -FilePath $log -Append; Write-Output $msg }

$tailscaleExe = "C:\Program Files\Tailscale\tailscale.exe"
$msi = "$env:TEMP\tailscale-setup.msi"

$installed = $false
for ($attempt = 1; $attempt -le 3; $attempt++) {
    Log "Install attempt $attempt"
    try {
        Invoke-WebRequest -Uri "https://pkgs.tailscale.com/stable/tailscale-setup-latest-amd64.msi" -OutFile $msi -UseBasicParsing
        $proc = Start-Process msiexec.exe -ArgumentList "/i `"$msi`" /quiet /norestart /log C:\Windows\Temp\tailscale-msi.log" -Wait -PassThru
        Log "msiexec exit code: $($proc.ExitCode)"
    } catch {
        Log "Download/install attempt $attempt threw: $_"
    }

    # msiexec can report success before the binary is fully placed; poll briefly.
    for ($i = 0; $i -lt 12; $i++) {
        if (Test-Path $tailscaleExe) { $installed = $true; break }
        Start-Sleep -Seconds 5
    }
    if ($installed) { break }
    Log "tailscale.exe not present after attempt $attempt, retrying"
    Start-Sleep -Seconds 15
}

if (-not $installed) {
    Log "FATAL: tailscale.exe never appeared after 3 install attempts"
    exit 1
}

Log "Running tailscale up"
& $tailscaleExe up --authkey=${tailscale_authkey} --hostname=sentinel-win-target
Log "tailscale up exit code: $LASTEXITCODE"

# --- Sysmon: process-creation telemetry the Windows Sigma rules actually query ---
# (Event ID 1 / process_creation. SwiftOnSecurity's config is the widely-used baseline
# that logs process creation with command lines, which is all these rules need.)
$sysmonZip = "$env:TEMP\Sysmon.zip"
$sysmonDir = "$env:TEMP\Sysmon"
$sysmonConfig = "$env:TEMP\sysmonconfig.xml"
$sysmonExe = "$sysmonDir\Sysmon64.exe"

Log "Downloading Sysmon"
Invoke-WebRequest -Uri "https://download.sysinternals.com/files/Sysmon.zip" -OutFile $sysmonZip -UseBasicParsing
Expand-Archive -Path $sysmonZip -DestinationPath $sysmonDir -Force

Log "Downloading SwiftOnSecurity Sysmon config"
Invoke-WebRequest -Uri "https://raw.githubusercontent.com/SwiftOnSecurity/sysmon-config/master/sysmonconfig-export.xml" -OutFile $sysmonConfig -UseBasicParsing

Log "Installing Sysmon"
$proc = Start-Process $sysmonExe -ArgumentList "-accepteula -i `"$sysmonConfig`"" -Wait -PassThru
Log "Sysmon install exit code: $($proc.ExitCode)"
if ($proc.ExitCode -ne 0) {
    Log "FATAL: Sysmon install failed"
    exit 1
}

# --- Winlogbeat: ships Sysmon (via the built-in ECS-mapping module) + Security/System
# logs to the shared Elasticsearch, same elastic-user credential auditbeat already uses
# on the Linux side (infra/compose/wazuh/auditbeat). The Sysmon module's ingest pipeline
# is what populates the process.executable / process.command_line ECS fields the
# deployed Windows detection rules query - see detections/deployed/proc_creation_win_*.json.
$winlogbeatVersion = "9.2.1"
$winlogbeatZip = "$env:TEMP\winlogbeat.zip"
$winlogbeatDir = "C:\Program Files\winlogbeat"

Log "Downloading Winlogbeat $winlogbeatVersion"
Invoke-WebRequest -Uri "https://artifacts.elastic.co/downloads/beats/winlogbeat/winlogbeat-$winlogbeatVersion-windows-x86_64.zip" -OutFile $winlogbeatZip -UseBasicParsing
Expand-Archive -Path $winlogbeatZip -DestinationPath "$env:TEMP\winlogbeat-extract" -Force
$extractedDir = Get-ChildItem "$env:TEMP\winlogbeat-extract" -Directory | Select-Object -First 1
Move-Item $extractedDir.FullName $winlogbeatDir

$winlogbeatConfig = @"
winlogbeat.event_logs:
  - name: Security
  - name: System

winlogbeat.modules:
  - module: sysmon
    enabled: true

setup.template.enabled: false
setup.ilm.enabled: false

output.elasticsearch:
  hosts: ["${elastic_url}"]
  username: "elastic"
  password: "${elastic_password}"

logging.level: info
logging.to_files: true
logging.files:
  path: C:\ProgramData\winlogbeat\logs
"@
Set-Content -Path "$winlogbeatDir\winlogbeat.yml" -Value $winlogbeatConfig -Encoding UTF8

Log "Installing Winlogbeat service"
Push-Location $winlogbeatDir
& powershell.exe -ExecutionPolicy Bypass -File ".\install-service-winlogbeat.ps1"
Log "Loading Sysmon module ingest pipeline into Elasticsearch"
# winlogbeat.exe logs routine info to stderr by design (Go/Beats convention). With
# $ErrorActionPreference = "Stop" (set globally above), PowerShell promotes that
# benign stderr output into a terminating NativeCommandError, killing the script
# before it ever reaches Start-Service below - it isn't an actual pipeline failure.
# Relax to "Continue" for just this call so stderr is treated as text, not an error,
# and check the real exit code explicitly afterward instead of relying on $?/throw.
$ErrorActionPreference = "Continue"
& ".\winlogbeat.exe" setup --pipelines -e -c ".\winlogbeat.yml" 2>&1 | Out-File -FilePath $log -Append
$setupExitCode = $LASTEXITCODE
$ErrorActionPreference = "Stop"
Log "winlogbeat setup --pipelines exit code: $setupExitCode"
Pop-Location

Log "Starting Winlogbeat service"
Set-Service -Name winlogbeat -StartupType Automatic
Start-Service -Name winlogbeat
Log "Winlogbeat service status: $((Get-Service winlogbeat).Status)"
