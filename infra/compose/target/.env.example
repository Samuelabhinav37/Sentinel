# Copy to .env and fill in. Never commit the real .env (.gitignore covers it).
#
# Points at the sentinel-elastic Tailscale hostname over MagicDNS and reuses the
# elastic superuser credential set up on that VM (infra/compose/elastic/.env) -
# the same convention infra/compose/wazuh/auditbeat uses.
#
# On the cloud attack targets these values are rendered into the sensor config by
# Terraform from infra/aws/terraform.tfvars / infra/azure/terraform.tfvars
# (elastic_url / elastic_password), not from this file.
ELASTIC_URL=http://sentinel-elastic:9200
ELASTIC_PASSWORD=changeme-elastic
