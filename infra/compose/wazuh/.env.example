# Copy to .env, fill in strong values, then run ./set-passwords.sh before first boot.
# Requirements (Wazuh indexer): 8-64 chars, upper+lower+digit+one of .*+?-
INDEXER_PASSWORD=changeme-indexer
DASHBOARD_PASSWORD=changeme-dashboard
API_PASSWORD=changeme-api
SENSOR_INTERFACE=ens3

# auditbeat.yml and responder.yml — points at the sentinel-elastic Tailscale hostname,
# reuses the same elastic superuser credential set up on that VM (see
# infra/compose/elastic/.env)
ELASTIC_URL=http://sentinel-elastic:9200
ELASTIC_PASSWORD=changeme-elastic

# responder.yml only — shared secret the Shuffle response workflow presents via the
# X-Responder-Token header. This endpoint can kill an arbitrary (non-protected) host
# process, so treat it like any other credential: generate with
# `python3 -c "import secrets; print(secrets.token_hex(24))"`, never commit the real value.
RESPONDER_TOKEN=changeme-responder-token
