N8N_HOST=100.90.159.33
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n

# Used by the LLM triage workflow to write enriched alerts back into
# Elasticsearch. Tailscale IP of the elastic VM, elastic user's password
# (same value as ELASTIC_PASSWORD in infra/compose/elastic/.env).
N8N_ELASTIC_URL=http://100.103.246.10:9200
N8N_ELASTIC_PASSWORD=changeme-mirror-of-elastic-.env

# Webhook URL for the Shuffle automated-response workflow (see
# infra/compose/soar/shuffle), used by llm-triage-push.json's response gate.
# Get the id from Shuffle's Webhook_1 trigger node ("Webhook URI"). Must use
# the Tailscale IP, not the "sentinel-soar" hostname -- see docker-compose.yml.
N8N_SHUFFLE_WEBHOOK_URL=http://100.90.159.33:3001/api/v1/hooks/webhook_<id>

# Second, independent model for llm-triage-push.json's dual-AI cross-check
# (Call Claude node) -- Anthropic API key, console.anthropic.com. The
# Cross-Check Gate only auto-fires when this model AND Ollama both flag an
# alert high/critical severity + low false-positive likelihood.
N8N_ANTHROPIC_API_KEY=changeme-anthropic-api-key
