# Copy to Shuffle/.env after cloning (see deploy.sh). Shuffle's own docker-compose.yml
# lives upstream - we don't vendor it here, just the deployment config + the two
# fixes needed to get v2.2.1 actually working against OpenSearch 3.2.0.

BACKEND_HOSTNAME=shuffle-backend
OUTER_HOSTNAME=<tailscale-ip-of-this-vm>
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
BACKEND_PORT=5001
SHUFFLE_APP_HOTLOAD_LOCATION=/opt/sentinel/Shuffle/shuffle-apps
SHUFFLE_FILE_LOCATION=/opt/sentinel/shuffle-files
DB_LOCATION=/opt/sentinel/Shuffle/shuffle-database
SHUFFLE_OPENSEARCH_PASSWORD=changeme-strong-password

# Fix 1: OpenSearch 3.2.0 refuses to start without this - the docker-compose.yml
# wires it up correctly (OPENSEARCH_INITIAL_ADMIN_PASSWORD=${SHUFFLE_OPENSEARCH_PASSWORD})
# but ships with nothing set here, so it silently defaults to blank and the
# opensearch container loops forever on "No custom admin password found."

# Fix 2: OpenSearch's bundled demo TLS cert is issued for node-0.example.com/localhost,
# not the shuffle-opensearch service name, so the backend's Go TLS client rejects it
# with "certificate is valid for node-0.example.com, localhost, not shuffle-opensearch".
# This is undocumented in Shuffle's own compose file/docs as of v2.2.1.
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true
