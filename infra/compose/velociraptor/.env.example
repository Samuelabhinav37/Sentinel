# Copy to .env on sentinel-wazuh (not committed -- .env is gitignored).

# Reachable only over Tailscale -- use the VM's Tailscale hostname/IP, not a
# public one (there's nothing to make it public: no OCI security-list rule
# opens these ports).
VELOCIRAPTOR_HOSTNAME=sentinel-wazuh
VELOCIRAPTOR_FRONTEND_PORT=8000
VELOCIRAPTOR_GUI_PORT=8889

# Change on first login -- this is only the bootstrap password for the
# initial admin account. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(18))"
VELOCIRAPTOR_INITIAL_ADMIN_PASSWORD=changeme-velociraptor-admin
