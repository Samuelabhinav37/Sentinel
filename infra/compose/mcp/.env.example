# Copy to .env on sentinel-soar (not committed -- .env is gitignored).

# Shared secret any MCP client must present via the X-MCP-Token header --
# same shape as infra/compose/wazuh/responder/.env's RESPONDER_TOKEN.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
MCP_TOKEN=changeme-mcp-token

# Elasticsearch -- Tailscale IP of the elastic VM, elastic user's password
# (same value as ELASTIC_PASSWORD in infra/compose/elastic/.env).
ELASTIC_URL=http://100.103.246.10:9200
ELASTIC_PASSWORD=changeme-mirror-of-elastic-.env

# Wazuh manager API (port 55000, not the Wazuh indexer -- see build-log for
# why). Same wazuh-wui credential the Wazuh dashboard already uses (same
# value as API_PASSWORD in infra/compose/wazuh/.env).
WAZUH_API_URL=https://sentinel-wazuh:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme-mirror-of-wazuh-.env

# Same webhook n8n's Cross-Check Gate posts to (see
# infra/compose/soar/n8n/.env's N8N_SHUFFLE_WEBHOOK_URL) -- must use the
# Tailscale IP, not a hostname.
SHUFFLE_WEBHOOK_URL=http://100.90.159.33:3001/api/v1/hooks/webhook_<id>

# Optional -- MISP instance/feed for the misp_search_ioc tool. Leave unset
# (or commented out) to run without MISP; the tool reports "not_configured"
# rather than erroring. Get an API key from your MISP instance's user
# profile (Auth Keys).
# MISP_URL=https://your-misp-instance.example
# MISP_API_KEY=changeme-misp-api-key
