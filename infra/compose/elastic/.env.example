# Copy to .env on the target VM (not committed — .env is gitignored).
ELASTIC_PASSWORD=changeme-elastic
KIBANA_PASSWORD=changeme-kibana

# Required for Kibana's alerting/detection-engine plugins (32+ hex chars each).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTED_SAVED_OBJECTS_KEY=changeme-generate-random-hex
SECURITY_ENCRYPTION_KEY=changeme-generate-random-hex
REPORTING_ENCRYPTION_KEY=changeme-generate-random-hex

# Optional -- both default to the full-deployment sizing (-Xms12g -Xmx12g
# heap, 16g container limit) if unset, so leaving this section out changes
# nothing for an existing deployment. For a lab/small-instance deployment,
# see docs/deployment-profiles.md for sized-down values (e.g. 3g/4g).
# ES_JAVA_OPTS=-Xms3g -Xmx3g
# ES_MEM_LIMIT=4g
