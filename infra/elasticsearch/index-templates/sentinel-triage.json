{
  "index_patterns": ["sentinel-triage*"],
  "priority": 200,
  "template": {
    "settings": {
      "index.number_of_replicas": 0,
      "index.lifecycle.name": "sentinel-audit-retention",
      "index.lifecycle.rollover_alias": "sentinel-triage"
    },
    "mappings": {
      "date_detection": false,
      "properties": {
        "@timestamp": { "type": "date" },
        "mttd_seconds": { "type": "long" },
        "triage_source": { "type": "keyword" },
        "triage": {
          "properties": {
            "severity": { "type": "keyword" },
            "false_positive_likelihood": { "type": "keyword" }
          }
        },
        "triage_secondary": {
          "properties": {
            "severity": { "type": "keyword" },
            "false_positive_likelihood": { "type": "keyword" }
          }
        },
        "cross_check_agreement": { "type": "boolean" }
      }
    }
  }
}
