{
  "index_patterns": ["sentinel-response-actions", "sentinel-response-actions-*"],
  "priority": 200,
  "template": {
    "settings": {
      "index.number_of_replicas": 0,
      "index.lifecycle.name": "sentinel-audit-retention",
      "index.lifecycle.rollover_alias": "sentinel-response-actions"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "action": { "type": "keyword" },
        "requested_pid": { "type": "long" },
        "comm": { "type": "keyword" },
        "result": { "type": "keyword" },
        "detail": { "type": "keyword" },
        "reason": { "type": "text" },
        "alert_id": { "type": "keyword" }
      }
    }
  }
}
